{
  "schemaVersion": 1,
  "id": "parallel",
  "version": "${version}",
  "name": "Parallel Players",
  "description": "Adds Terraria-style characters for Minecraft.",
  "authors": ["fey"],
  "contact": {
    "homepage": "https://modrinth.com/mod/parallelplayers",
    "sources": "https://github.com/Tunic-Studios/ParallelPlayers",
    "issues": "https://github.com/Tunic-Studios/ParallelPlayers/issues"
  },
  "license": "MIT",
  "icon": "assets/parallel/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.tunic.parallel.client.ParallelPlayersDataGenerator"
    ],
    "client": [
      "com.tunic.parallel.client.ParallelPlayersClient"
    ],
    "main": [
      "com.tunic.parallel.ParallelPlayers"
    ],
    "modmenu": [
      "com.tunic.parallel.client.ParallelModMenu"
    ]
  },
  "mixins": [
    "parallel.mixins.json",
    {
      "config": "parallel.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
